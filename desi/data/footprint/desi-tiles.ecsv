# %ECSV 0.9
# ---
# datatype:
# - {name: TILEID, datatype: int32, description: Unique tile ID}
# - {name: RA, unit: deg, datatype: float64, description: Right ascension}
# - {name: DEC, unit: deg, datatype: float64, description: Declination}
# - {name: PASS, datatype: int16, description: DESI layer}
# - {name: IN_DESI, datatype: int16, description: 1=within DESI footprint; 0=outside}
# - {name: EBV_MED, unit: mag, datatype: float32, description: Median Galactic E(B-V)
#     extinction in tile}
# - {name: AIRMASS, datatype: float32, description: Airmass if observed at hour angle
#     15 deg}
# - {name: STAR_DENSITY, unit: 1 / deg2, datatype: float32, description: median number
#     density of Gaia stars brighter than 19.5 mag in tile}
# - {name: EXPOSEFAC, datatype: float32, description: Multiplicative exposure time factor
#     from airmass and E(B-V)}
# - {name: PROGRAM, datatype: string, description: 'DARK, GRAY, BRIGHT, or EXTRA'}
# - {name: OBSCONDITIONS, datatype: int32, description: '1 for DARK, 2 for GRAY, 4 for
#     BRIGHT, 0 for EXTRA'}
# - {name: CENTERID, datatype: int32, description: Unique tile ID of pass 0 tile corresponding
#     to this tile}
# - {name: IMAGEFRAC_G, datatype: float32, description: Fraction of this tile within
#     1.605 deg with g imaging}
# - {name: IMAGEFRAC_R, datatype: float32, description: Fraction of this tile within
#     1.605 deg with r imaging}
# - {name: IMAGEFRAC_Z, datatype: float32, description: Fraction of this tile within
#     1.605 deg with z imaging}
# - {name: IMAGEFRAC_GR, datatype: float32, description: Fraction of this tile within
#     1.605 deg with gr imaging}
# - {name: IMAGEFRAC_GRZ, datatype: float32, description: Fraction of this tile within
#     1.605 deg with grz imaging}
# - {name: IN_IMAGING, datatype: float32, description: Central tile has imagefrac_grz
#     > 0.9}
# meta: !!omap
# - {EXTNAME: TILES}
# schema: astropy-2.0
