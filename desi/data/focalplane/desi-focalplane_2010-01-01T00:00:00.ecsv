# %ECSV 0.9
# ---
# datatype:
# - {name: PETAL, datatype: int32, description: 'Petal location [0-9]'}
# - {name: DEVICE, datatype: int32, description: Device location on the petal}
# - {name: LOCATION, datatype: int32, description: PETAL * 1000 + DEVICE}
# - {name: PETAL_ID, datatype: int32, description: The physical petal ID}
# - {name: DEVICE_ID, datatype: string, description: The physical device ID string}
# - {name: DEVICE_TYPE, datatype: string, description: 'The device type (POS, ETC, FIF)'}
# - {name: SLITBLOCK, datatype: int32, description: The slit block where this fiber goes}
# - {name: BLOCKFIBER, datatype: int32, description: The fiber index within the slit block}
# - {name: CABLE, datatype: int32, description: The cable ID}
# - {name: CONDUIT, datatype: string, description: The conduit}
# - {name: FIBER, datatype: int32, description: PETAL * 500 + SLITBLOCK * 25 + BLOCKFIBER}
# - {name: FWHM, datatype: float64, description: FWHM at f/3.9}
# - {name: FRD, datatype: float64, description: FRD Throughput}
# - {name: ABS, datatype: float64, description: ABS Throughput}
# - {name: OFFSET_X, unit: mm, datatype: float64, description: X location of positioner center}
# - {name: OFFSET_Y, unit: mm, datatype: float64, description: Y location of positioner center}
# - {name: OFFSET_T, unit: degrees, datatype: float64, description: THETA zero point angle}
# - {name: OFFSET_P, unit: degrees, datatype: float64, description: PHI zero point angle}
# - {name: LENGTH_R1, unit: mm, datatype: float64, description: Length of THETA arm}
# - {name: LENGTH_R2, unit: mm, datatype: float64, description: Length of PHI arm}
# - {name: MAX_T, unit: degrees, datatype: float64, description: Maximum THETA angle relative to OFFSET_T}
# - {name: MIN_T, unit: degrees, datatype: float64, description: Minimum THETA angle relative to OFFSET_T}
# - {name: MAX_P, unit: degrees, datatype: float64, description: Maximum PHI angle relative to OFFSET_P}
# - {name: MIN_P, unit: degrees, datatype: float64, description: Minimum PHI angle relative to OFFSET_P}
# schema: astropy-2.0
